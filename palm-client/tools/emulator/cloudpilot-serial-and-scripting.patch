diff --git a/src/cloudpilot/native/SerialBridge.cpp b/src/cloudpilot/native/SerialBridge.cpp
new file mode 100644
index 0000000..b55860a
--- /dev/null
+++ b/src/cloudpilot/native/SerialBridge.cpp
@@ -0,0 +1,69 @@
+#include "SerialBridge.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <termios.h>
+#include <unistd.h>
+
+#include <iostream>
+
+#include "EmSession.h"
+
+using namespace std;
+
+SerialBridge::SerialBridge(const string& path) : path(path) {}
+
+SerialBridge::~SerialBridge() {
+    if (fd >= 0) close(fd);
+}
+
+bool SerialBridge::Open() {
+    fd = open(path.c_str(), O_RDWR | O_NOCTTY | O_NONBLOCK);
+    if (fd < 0) {
+        cerr << "serial: cannot open " << path << ": " << strerror(errno) << endl;
+        return false;
+    }
+
+    struct termios tio;
+    if (tcgetattr(fd, &tio) == 0) {
+        cfmakeraw(&tio);
+        cfsetspeed(&tio, B115200);
+        tcsetattr(fd, TCSANOW, &tio);
+    }
+
+    cout << "serial: cradle port bridged to " << path << endl << flush;
+    return true;
+}
+
+void SerialBridge::Attach() { gSession->SetTransportSerial(kUARTSerial, transport); }
+
+void SerialBridge::Cycle() {
+    if (fd < 0) return;
+
+    uint8 buffer[4096];
+    ssize_t got = read(fd, buffer, sizeof(buffer));
+
+    // Bytes arriving while the Palm has the port closed are lost on a real
+    // cable too.
+    if (got > 0 && transport->IsOpen()) transport->Send(static_cast<int>(got), buffer, true);
+
+    int pending = transport->RxBytesPending();
+    if (pending > 0) {
+        const uint8* data = reinterpret_cast<const uint8*>(transport->Receive());
+
+        while (pending > 0) {
+            ssize_t written = write(fd, data, pending);
+
+            if (written < 0) {
+                if (errno == EAGAIN || errno == EINTR) {
+                    usleep(1000);
+                    continue;
+                }
+                break;
+            }
+
+            data += written;
+            pending -= static_cast<int>(written);
+        }
+    }
+}
diff --git a/src/cloudpilot/native/SerialBridge.h b/src/cloudpilot/native/SerialBridge.h
new file mode 100644
index 0000000..07686f9
--- /dev/null
+++ b/src/cloudpilot/native/SerialBridge.h
@@ -0,0 +1,27 @@
+#ifndef _SERIAL_BRIDGE_H_
+#define _SERIAL_BRIDGE_H_
+
+#include <string>
+
+#include "EmTransportSerialBuffer.h"
+
+// Bridges the emulated cradle serial port (kUARTSerial) to a host tty or
+// pty, so a Palm app can talk to real serial software on the host -- for
+// example FujiNet-PC on the other end of a socat pty pair.
+class SerialBridge {
+   public:
+    explicit SerialBridge(const std::string& path);
+    ~SerialBridge();
+
+    bool Open();
+    void Attach();  // after the session is initialized
+    void Cycle();   // move pending bytes both ways; call every loop
+
+   private:
+    std::string path;
+    int fd{-1};
+    // Owned by the session once attached (EmSession deletes its transports).
+    EmTransportSerialBuffer* transport{new EmTransportSerialBuffer()};
+};
+
+#endif  // _SERIAL_BRIDGE_H_
