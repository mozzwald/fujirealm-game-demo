+                                                     y * surface->pitch);
+            uint8* src = buffer + y * frame.bytesPerLine;
+
+            switch (frame.bpp) {
+                case 1: {
+                    Nibbler<1> n;
+                    n.reset(src, frame.margin);
+                    for (uint32 x = 0; x < frame.lineWidth; x++)
+                        line[x] = n.nibble() ? GREY16[15] : GREY16[0];
+                } break;
+                case 2: {
+                    Nibbler<2> n;
+                    n.reset(src, frame.margin);
+                    for (uint32 x = 0; x < frame.lineWidth; x++) line[x] = palette2[n.nibble()];
+                } break;
+                case 4: {
+                    Nibbler<4> n;
+                    n.reset(src, frame.margin);
+                    for (uint32 x = 0; x < frame.lineWidth; x++) line[x] = GREY16[n.nibble()];
+                } break;
+                case 24:
+                    memcpy(line, src + 4 * frame.margin, 4 * frame.lineWidth);
+                    break;
