+    // The LCD as the device shows it (2-bit greys through the Dragonball's
+    // grey palette register), one pixel per Palm pixel.
+    void CmdScreenshot(vector<string> args, cli::CommandEnvironment& env, void* context) {
+        if (args.size() != 1) return env.PrintUsage();
+
+        static constexpr uint32 GREY16[] = {
+            0xffd2d2d2, 0xffc4c4c4, 0xffb6b6b6, 0xffa8a8a8, 0xff9a9a9a, 0xff8c8c8c,
+            0xff7e7e7e, 0xff707070, 0xff626262, 0xff545454, 0xff464646, 0xff383838,
