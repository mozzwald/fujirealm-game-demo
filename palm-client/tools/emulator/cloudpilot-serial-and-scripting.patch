+        Frame frame(320 * 480 * 4);
+        if (!gSession->IsPowerOn() || !EmHAL::CopyLCDFrame(frame, true)) {
+            cout << "screenshot failed: no frame" << endl << flush;
+            return;
+        }
+
+        SDL_Surface* surface = SDL_CreateRGBSurfaceWithFormat(
+            0, frame.lineWidth, frame.lines, 32, SDL_PIXELFORMAT_ABGR8888);
+        uint8* buffer = frame.GetBuffer();
+        uint16 mapping = EmHAL::GetLCD2bitMapping();
+        uint32 palette2[4] = {GREY16[mapping & 0xf], GREY16[(mapping >> 4) & 0xf],
