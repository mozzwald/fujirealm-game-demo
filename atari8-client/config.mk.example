# Copy to config.mk (untracked) to bake your own server into the XEX without
# passing the variables on every build. Same variable names the Lynx client
# takes.
#
#   cp config.mk.example config.mk

SERVER_HOST = 192.168.1.100
HYBRID_SERVER_PORT = 9000
LOGIN_SERVER_PORT = 9010

# How many other players this build can render at once.
# REMOTE_PLAYER_SLOTS = 12

# Draw the local player with Player/Missile Graphics (extra colors, taller
# sprite, smooth sub-tile motion) instead of the 2x2 character sprite.
# Needs RAM at $A000-$A7FF, which the client probes for at startup.
# PMG_PLAYER = 1
