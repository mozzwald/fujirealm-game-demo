# Copy to config.mk (untracked) to bake your own server into the cart without
# passing the variables on every build. Same variable names the Atari client
# takes.
#
#   cp config.mk.example config.mk
#
# SERVER_HOST is limited to 31 characters and is checked at compile time.

SERVER_HOST = 192.168.1.100
HYBRID_SERVER_PORT = 9000
LOGIN_SERVER_PORT = 9010
